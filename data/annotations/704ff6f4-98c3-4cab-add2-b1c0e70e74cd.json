      "uuid": "ece0dd9b-6d95-4269-8f27-5a73a7967df1"
    },
    {
      "start_time": 106,
      "end_time": 117,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "The host reminds viewers that all three men claim to be Charles Hickson and begins the panel questioning."
            }
          ]
        }
      ],
      "tags": [
        {
          "category": "_uncategorized_",
          "tag": "Panel Questioning"
        },
