    },
    {
      "start_time": 120,
      "end_time": 130,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Orson Bean asks contestant number one whether he caught anything after being returned. The question uses humor to test the story indirectly."
            }
          ]
        }
      ],
      "tags": [
        {
          "category": "_uncategorized_",
          "tag": "Orson Bean"
        },
        {
          "category": "_uncategorized_",
