      "end_time": 177,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "A panelist asks number one about the creatures claws and whether they had thumbs, testing the physical plausibility of the written description."
            }
          ]
        }
      ],
      "tags": [
