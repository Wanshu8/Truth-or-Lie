      "uuid": "3af6af7d-1924-4824-a6cf-088fbcb42f3a"
    },
    {
      "start_time": 155,
      "end_time": 162,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Orson Bean asks number three \"Who is Godzilla?\" The joke shifts the UFO claim toward popular monster culture and comic disbelief."
            }
          ]
        }
      ],
      "tags": [
        {
