      "uuid": "035c505a-67e4-4b3f-a7bc-6d4e6c2c5c62"
    },
    {
      "start_time": 130,
      "end_time": 155,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Orson Bean challenges the meaning of the polygraph, noting that it may show belief rather than factual truth. Contestant number three gives a cautious answer."
            }
          ]
        }
      ],
      "tags": [
        {
          "category": "_uncategorized_",
          "tag": "Orson Bean"
        },
        {
