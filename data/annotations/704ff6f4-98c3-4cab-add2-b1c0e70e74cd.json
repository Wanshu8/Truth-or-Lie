      "end_time": 268,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Number two is asked whether any language or communication occurred during the examination. He reports yelling and hearing a buzzing sound."
            }
          ]
        }
      ],
      "tags": [
