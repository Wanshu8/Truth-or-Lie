      "end_time": 254,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Nipsey Russell asks number three what he was drinking that night, jokingly suggesting intoxication as an alternative explanation."
            }
          ]
        }
      ],
      "tags": [
