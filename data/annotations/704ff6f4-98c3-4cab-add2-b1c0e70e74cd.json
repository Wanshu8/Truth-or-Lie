    },
    {
      "start_time": 225,
      "end_time": 234,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Peggy Cass ask where the experience happened. The repeated Mississippi answers by number 1 and 2 confirm a basic factual detail."
            }
          ]
        }
      ],
      "tags": [
