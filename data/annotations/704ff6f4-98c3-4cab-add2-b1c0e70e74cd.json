          "tag": "Certainty Claim"
        },
        {
          "category": "_uncategorized_",
          "tag": "Signed Statement"
        }
      ],
      "uuid": "d3c87bb5-a1d9-4d02-9437-0b4a017cd6f1"
    },
    {
      "start_time": 99,
      "end_time": 105,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Music playing while the three contestants walking to the seat and sat down."
            }
          ]
        }
      ],
      "tags": [
        {
          "category": "_uncategorized_",
          "tag": "Transition"
