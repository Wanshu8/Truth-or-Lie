{"publish":{"publish_pages_app":true,"publish_sha":"","publish_iso_date":"","publish_static_site":false},"users":[{"login_name":"Wanshu8","avatar_url":"https://avatars.githubusercontent.com/u/145869867?v=4","admin":true}],"project":{"github_org":"Wanshu8","is_private":false,"title":"Performing Credibility: Charles Hickson, Pascagoula, and UFO Testimony on To Tell The Truth","description":"This project examines Charles Hickson’s appearance on To Tell the Truth after the 1973 Pascagoula UFO incident. Rather than proving or disproving the event, it analyzes how television turns a witness account into a public credibility test. The host reads Hickson’s signed statement, while Hickson and two impostors answer questions from the panel. Through AVAnnotate, the project highlights speech, gaze, posture, humor, hesitation, audience reaction, and the final reveal. The goal is to show how credibility is staged through performance, media format, and public judgment, not only through the content of testimony itself.","language":"en","slug":"Truth-or-Lie","creator":"Wanshu8","authors":"Wanshu Zhang","media_player":"avannotate","auto_populate_home_page":true,"additional_users":[],"tags":{"tagGroups":[{"category":"_uncategorized_","color":"#A3A3A3"}],"tags":[{"category":"_uncategorized_","tag":"Opening"},{"category":"_uncategorized_","tag":"Game Show Format"},{"category":"_uncategorized_","tag":"Entertainment Framing"},{"category":"_uncategorized_","tag":"Staging"},{"category":"_uncategorized_","tag":"Truth Test"},{"category":"_uncategorized_","tag":"Impostor Performance"},{"category":"_uncategorized_","tag":"Identity Claim"},{"category":"_uncategorized_","tag":"Eye Movement"},{"category":"_uncategorized_","tag":"Head Movement"},{"category":"_uncategorized_","tag":"Blink"},{"category":"_uncategorized_","tag":"Lip Movement"},{"category":"_uncategorized_","tag":"Facial Expression"},{"category":"_uncategorized_","tag":"Body Language"},{"category":"_uncategorized_","tag":"Eyebrow Moveme