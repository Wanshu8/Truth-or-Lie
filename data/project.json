{"publish":{"publish_pages_app":true,"publish_sha":"","publish_iso_date":"","publish_static_site":false},"users":[{"login_name":"Wanshu8","avatar_url":"https://avatars.githubusercontent.com/u/145869867?v=4","admin":true}],"project":{"github_org":"Wanshu8","is_private":false,"title":"Performing Credibility: Charles Hickson, Pascagoula, and UFO Testimony on To Tell The Truth","description":"This project examines Charles Hickson’s appearance on To Tell the Truth after the 1973 Pascagoula UFO incident. Rather than proving or disproving the event, it analyzes how television turns a witness account into a public credibility test. The host reads Hickson’s signed statement, while Hickson and two impostors answer questions from the panel. Through AVAnnotate, the project highlights speech, gaze, posture, humor, hesitation, audience reaction, and the final reveal. The goal is to show how credibility is staged through performance, media format, and public judgment, not only through the content of testimony itself.","language":"en","slug":"Truth-or-Lie","creator":"Wanshu8","authors":"Wanshu Zhang","media_player":"avannotate","auto_populate_home_page":true,"additional_users":[],"tags":{"tagGroups":[{"category":"Structure","color":"#ADFFD9"},{"category":"Event","color":"#ADFEFF"},{"category":"Interaction","color":"#99E6FF"},{"category":"Credibility","color":"#88C9F2"},{"category":"Media","color":"#99AFF2"},{"category":"People","color":"#B3B3E6"},{"category":"Gaze","color":"#C195DB"},{"category":"Face","color":"#DA9ECF"},{"category":"Body","color":"#F2A7C3"}],"tags":[{"tag":"Opening","category":"Structure"},{"tag":"Transition","category":"Structure"},{"tag":"Signed Statement","category":"Structure"},{"tag":"Panel Questioning","category":"Structure"},{"tag":"Voting","category":"Structure"},{"tag":"Reveal","category":"Structure"},{"tag":"Post Reveal Interview","category":"Structure"},{"tag":"Closing","category":"Structure"},{"tag":"Event Summary","category":"Event"},{"tag":"Craft Des